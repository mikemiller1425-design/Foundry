# Foundry — configuration reference (AC-104 / F-102)
#
# Every configuration variable the repository reads, with its default and
# its effect. This file is the single place; if a variable is not here, no
# code reads it.
#
# HOW IT IS USED
#   Copy to `.env` (git-ignored) and edit, or export variables in your
#   shell. `pnpm dev` loads `.env` via Node's own env-file support — no
#   dependency, no bespoke parser. Variables already exported take
#   precedence, so `PORT=4001 pnpm dev` overrides the file.
#
#   Nothing else loads `.env`. Running `apps/api` or `apps/agent-city`
#   directly reads only the real environment.
#
# EVERY VARIABLE IS OPTIONAL. With an empty environment, `pnpm dev` starts
# a working Foundry using the defaults below.
#
# Audit note: PV1-029 recorded eleven configuration variables. The true
# count of variables read by source is thirteen; the two it omitted are
# CI and PERF_HEADED, both test-harness only. Three more are introduced by
# the launcher and marked below. Corrected here rather than carried
# forward silently.

# ─────────────────────────────────────────────────────────────────────────
# Launch (scripts/dev.mjs) — introduced by AC-104
# ─────────────────────────────────────────────────────────────────────────

# Port for the frontend dev/production server.
# Default: 3000. Effect: `pnpm dev` serves the app here and fails with an
# actionable message if the port is busy. Equivalent to `--web-port`.
FOUNDRY_WEB_PORT=3000

# Ports used by `pnpm verify:launch` only, so the check never collides with
# a session you already have running.
# Defaults: 4410 and 3410.
VERIFY_API_PORT=4410
VERIFY_WEB_PORT=3410

# ─────────────────────────────────────────────────────────────────────────
# Backend service (apps/api)
# ─────────────────────────────────────────────────────────────────────────

# Port the API listens on.
# Default: 4000. Effect: binds the HTTP surface (/health, /world-state,
# /entities, /events, /events/stream, /commands, /objectives). Also the
# port `pnpm dev` health-gates before starting the frontend.
PORT=4000

# SQLite file holding the event log and projections.
# Default: apps/api/data/foundry.sqlite. Effect: the durable operational
# truth. Delete it to start from an empty world — the only way to clear an
# active project, since V1 has no command that closes one.
FOUNDRY_DB_PATH=apps/api/data/foundry.sqlite

# Identity minted for the human operator credential at boot.
# Default: operator-1. Effect: the actorId recorded on operator-authored
# events, and the principal that must match a command's `actor` field.
FOUNDRY_OPERATOR_ID=operator-1

# ─────────────────────────────────────────────────────────────────────────
# Frontend (apps/agent-city)
# ─────────────────────────────────────────────────────────────────────────

# Base URL of the API. Presence selects backend mode; absence selects the
# deterministic mock runtime.
# Default: unset (mock mode). Effect: `pnpm dev` sets this for the frontend
# automatically; `pnpm dev --mock` withholds it.
#
# LIMITATION (PV1-028, owned by AC-105): Next inlines NEXT_PUBLIC_* at
# build time, so a production build is permanently one mode and switching
# requires a rebuild. Run-time mode selection is AC-105's job, not AC-104's.
NEXT_PUBLIC_FOUNDRY_API_URL=http://127.0.0.1:4000

# ─────────────────────────────────────────────────────────────────────────
# Controlled Claude Code runtime (packages/runtime-adapters, apps/api)
#
# Read only by the FBL-028 controlled-stage entrypoint. Not used by
# `pnpm dev`, and running that entrypoint needs its own explicit operator
# authorization — the V1 one is spent.
# ─────────────────────────────────────────────────────────────────────────

# Absolute path to the `claude` executable.
# Default: resolved from a fixed known location. Effect: the only binary
# the adapter will execute; there is no PATH lookup by design.
FOUNDRY_CLAUDE_PATH=

# Absolute path to the `git` executable.
# Default: /usr/bin/git. Effect: used for the post-run write-scope diff
# that determines whether a run escaped its permitted paths.
FOUNDRY_GIT_PATH=

# Identifier recorded for the AgentRun the controlled stage creates.
# Default: generated per run. Effect: correlates evidence with the run.
FOUNDRY_AGENT_RUN_ID=

# BuildStage the controlled run is attributed to.
# Default: a fixture stage id. Effect: links the run to a stage record.
FOUNDRY_STAGE_ID=

# Directory the controlled run writes its evidence into.
# Default: <cwd>/docs/evidence/fbl-028. Effect: destination for
# evidence.json, diff.patch, stdout.txt, stderr.txt, tests.txt.
#
# WARNING (PV1-023, owned by AC-115): the default points inside the
# approved evidence tree and the entrypoint does not refuse to overwrite.
# Set this to a scratch directory before any re-run.
FOUNDRY_EVIDENCE_DIR=

# Keep the temporary fixture workspace after a controlled run.
# Default: unset (workspace is removed). Effect: set to any value to retain
# it for inspection.
FOUNDRY_KEEP_FIXTURE=

# ─────────────────────────────────────────────────────────────────────────
# Test harness only — never read by application code
# ─────────────────────────────────────────────────────────────────────────

# Enables `preserveDrawingBuffer` on the WebGL canvas so Playwright can read
# back real pixels.
# Default: unset. Effect: set to 1 by the Playwright dev server only; real
# dev and production runs never pay that cost.
NEXT_PUBLIC_E2E=

# Continuous-integration marker.
# Default: unset. Effect: when set, Playwright forbids `test.only` and will
# not reuse an already-running dev server.
CI=

# Run the performance suite headed, for eyeballing what is measured.
# Default: unset (headless). Effect: set to 1 to show the browser.
PERF_HEADED=
